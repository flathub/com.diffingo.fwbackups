{
    "app-id": "com.diffingo.fwbackups",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "fwbackups",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--filesystem=host",
        "--share=network",
        "--socket=ssh-auth",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "python3-modules.json",
        {
            "name": "fwbackups",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/stewartadam/fwbackups.git",
                    "tag": "v1.43.8",
                    "commit": "8f089c8bb537616a7508383e78dc37359d0cd9d2",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v(\\d+\\.\\d+\\.\\d+)$"
                    }
                }
            ]
        }
    ]
}
